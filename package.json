{
  "name": "breaking-bellman",
  "version": "1.2.0",
  "description": "Learn reinforcement learning by breaking it: a single-page game where real RL algorithms train in your browser and fail in front of you.",
  "license": "MIT",
  "author": "Hadrien Cornier",
  "repository": { "type": "git", "url": "https://github.com/Hadrien-Cornier/breaking-bellman.git" },
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node serve.mjs",
    "test": "node --test test/*.test.js",
    "smoke": "node build.mjs && node test/ui/smoke.mjs",
    "pages": "sh publish-pages.sh"
  }
}
